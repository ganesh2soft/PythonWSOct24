"""
ASGBOOM - Telegram alerts for Nifty / Bank Nifty / Midcap Select vs the tg-due-level docs.

Runs as a separate script (own terminal), next to tradeguide:
    python asgboom.py              -> live: sends alerts to the ASG Telegram group
    python asgboom.py --dry-run    -> prints alerts only, sends nothing
    python asgboom.py --test-send  -> sends one test message and exits

Reads prices from tradeguide's mainindex.json (updated by the scheduler every 5 minutes),
so tradeguide (Flask + Upstox login) must be running.

Rules (09:17 to 15:12 IST):
  1. Initial alert at 09:17 (first snapshot of the day): price + nearest level above/below.
  2. Move alert: when an index moves >= STEP points from its reference (any direction).
     Rolling reference: after an alert the reference resets to that price.
  3. Near-level alert: when an index comes within STEP points of a level
     (each level alerts once per day).
  STEP: Nifty 50, Bank Nifty 150, Midcap Select 30.

Secrets: put them in asgboom.env (same folder), never in this file:
    ASGBOOM_BOT_TOKEN=123456:ABC...
    ASG_CHAT_ID=-100xxxxxxxxxx
"""
import json
import os
import sys
import time
from datetime import datetime, date

BASE = os.path.dirname(os.path.abspath(__file__))
MAININDEX = os.path.join(BASE, 'mainindex.json')
LEVELS = os.path.join(BASE, 'tgrepo', 'due_levels.json')
ENVFILE = os.path.join(BASE, 'asgboom.env')
STATEFILE = os.path.join(BASE, 'tgrepo', 'asgboom_state.json')
LOGFILE = os.path.join(BASE, 'asgboom.log')

START = '09:17'
STOP = '15:12'
POLL_SECONDS = 30
STALE_MINUTES = 12

# key in mainindex.json -> (short name, step points)
INDICES = {
    'NIFTY 50':   ('NIFTY', 50),
    'BANK NIFTY': ('BN', 150),
    'MIDCAP':     ('MID', 30),
}

DRY_RUN = '--dry-run' in sys.argv


def log(msg):
    line = f"{datetime.now().strftime('%Y-%m-%d %H:%M:%S')} {msg}"
    print(line)
    with open(LOGFILE, 'a', encoding='utf-8') as f:
        f.write(line + '\n')


def load_env():
    env = {}
    if os.path.exists(ENVFILE):
        with open(ENVFILE, encoding='utf-8') as f:
            for raw in f:
                raw = raw.strip()
                if raw and not raw.startswith('#') and '=' in raw:
                    k, v = raw.split('=', 1)
                    env[k.strip()] = v.strip().strip('"').strip("'")
    return env


def send(text):
    if DRY_RUN:
        log('[DRY-RUN] would send:\n' + text)
        return True
    env = load_env()
    token, chat = env.get('ASGBOOM_BOT_TOKEN'), env.get('ASG_CHAT_ID')
    if not token or not chat:
        log('ERROR: ASGBOOM_BOT_TOKEN / ASG_CHAT_ID missing in asgboom.env - alert NOT sent')
        return False
    import requests
    url = f'https://api.telegram.org/bot{token}/sendMessage'
    for attempt in range(3):
        try:
            r = requests.post(url, data={'chat_id': chat, 'text': text}, timeout=15)
            if r.status_code == 200:
                log('Sent: ' + text.splitlines()[0])
                return True
            # never log the URL (it contains the token)
            log(f'Telegram error {r.status_code}: {r.text[:200]}')
        except Exception as e:
            log(f'Telegram send failed (attempt {attempt + 1}): {type(e).__name__}')
        time.sleep(5)
    return False


def fmt(x):
    return f'{x:,.2f}'.rstrip('0').rstrip('.') if x != int(x) else f'{int(x):,}'


def load_levels():
    with open(LEVELS, encoding='utf-8') as f:
        return json.load(f)


def latest_snapshot():
    """Return (timestamp, {key: ltp}) for today's latest mainindex entry, or None."""
    for _ in range(3):  # file may be mid-write by tradeguide
        try:
            with open(MAININDEX, encoding='utf-8') as f:
                data = json.load(f)
            break
        except (json.JSONDecodeError, OSError):
            time.sleep(2)
    else:
        return None
    today = date.today().isoformat()
    todays = [d for d in data if str(d.get('timestamp', '')).startswith(today)]
    if not todays:
        return None
    last = todays[-1]
    prices = {i['index']: float(i['ltp']) for i in last.get('main_index', []) if i.get('index') in INDICES}
    if len(prices) < len(INDICES):
        return None
    return last['timestamp'], prices


def nearest(levels, price):
    above = [l for l in levels if l['level'] >= price]
    below = [l for l in levels if l['level'] < price]
    a = min(above, key=lambda l: l['level']) if above else None
    b = max(below, key=lambda l: l['level']) if below else None
    return a, b


def level_line(levels, price):
    a, b = nearest(levels, price)
    up = f"above {fmt(a['level'])} {a['cat']} (+{price_gap(a['level'], price)})" if a else 'above: none'
    dn = f"below {fmt(b['level'])} {b['cat']} (-{price_gap(price, b['level'])})" if b else 'below: none'
    return f'{up} | {dn}'


def price_gap(hi, lo):
    return f'{hi - lo:,.0f}'


def load_state():
    today = date.today().isoformat()
    if os.path.exists(STATEFILE):
        try:
            with open(STATEFILE, encoding='utf-8') as f:
                st = json.load(f)
            if st.get('date') == today:
                return st
        except Exception:
            pass
    return {'date': today, 'initial_sent': False, 'refs': {}, 'alerted_levels': {}, 'last_ts': None}


def save_state(st):
    tmp = STATEFILE + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(st, f, indent=1)
    os.replace(tmp, STATEFILE)


def closest(levels, price):
    return min(levels, key=lambda l: abs(l['level'] - price))


def message(hhmm, prices, levels):
    # User's format:
    # ASGBOOM | <time>
    # NIFTY Spot <value> | Near to Category <category> | Level <level>   (same for BN, MID)
    lines = [f'ASGBOOM | Alert Time {hhmm}']
    for key, (name, step) in INDICES.items():
        p = prices[key]
        c = closest(levels[key], p)
        lines.append(f"{name} Spot {fmt(p)} | Near to Category {c['cat']} | Level {fmt(c['level'])}")
    return '\n'.join(lines)


def process(st, ts, prices, levels):
    hhmm = ts[11:16]

    if not st['initial_sent']:
        for key in INDICES:
            st['refs'][key] = {'price': prices[key], 'time': hhmm}
        if send(message(hhmm, prices, levels)):
            st['initial_sent'] = True
        return

    fire = []
    for key, (name, step) in INDICES.items():
        p = prices[key]
        ref = st['refs'].get(key)
        if ref and abs(p - ref['price']) >= step:          # move alert (rolling reference)
            fire.append(f"{name} move {p - ref['price']:+,.0f}")
            st['refs'][key] = {'price': p, 'time': hhmm}
        done = st['alerted_levels'].setdefault(key, [])
        for l in levels[key]:                               # near-level alert, once per level per day
            if abs(p - l['level']) <= step and l['level'] not in done:
                fire.append(f"{name} near {fmt(l['level'])}")
                done.append(l['level'])
    if fire:
        log('Trigger: ' + '; '.join(fire))
        send(message(hhmm, prices, levels))


def main():
    if '--test-send' in sys.argv:
        ok = send(f"ASGBOOM test message {datetime.now().strftime('%d-%b %H:%M')} - bot is connected.")
        print('Test sent' if ok else 'Test FAILED - see asgboom.log')
        return
    levels = load_levels()
    st = load_state()
    log(f"ASGBOOM started ({'DRY-RUN' if DRY_RUN else 'LIVE'}), window {START}-{STOP}")
    stale_warned = False
    while True:
        now = datetime.now().strftime('%H:%M')
        if now > STOP:
            log('Reached 15:12 - ASGBOOM stopped for today.')
            break
        if now >= START:
            snap = latest_snapshot()
            if snap:
                ts, prices = snap
                age = (datetime.now() - datetime.strptime(ts, '%Y-%m-%d %H:%M:%S')).total_seconds() / 60
                if age > STALE_MINUTES:
                    if not stale_warned:
                        log(f'WARNING: mainindex.json is {age:.0f} min old - is tradeguide running?')
                        stale_warned = True
                elif ts != st['last_ts']:
                    stale_warned = False
                    process(st, ts, prices, levels)
                    st['last_ts'] = ts
                    save_state(st)
        time.sleep(POLL_SECONDS)


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        log('ASGBOOM stopped by user (Ctrl+C).')
